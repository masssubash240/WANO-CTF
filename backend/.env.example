# =============================================================================
# WANO CTF — BACKEND ENV (server-side secrets only)
# Host on Render / Railway / VPS. Never expose any of these to the browser.
# =============================================================================

# ---- App ----
APP_NAME="WANO CTF API"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
SITE_URL=https://ctf.wano-fest.com

# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_LEGACY_JWT_SECRET
SUPABASE_JWKS_URL=                 # optional; defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=challenge-files

# ---- Database (SQLAlchemy async DSN) ----
# Supabase pooler recommended in production (port 6543 / transaction mode)
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- Auth / crypto ----
JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(64))"
ADMIN_JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(64))"
ACCESS_TOKEN_TTL_MINUTES=60
FLAG_PEPPER=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Bootstrap admin (used by `python -m app.scripts.seed` only)
ADMIN_EMAIL=admin@wano-fest.com
ADMIN_PASSWORD=ChangeMe_Strong#2026

# ---- Competition / platform ----
CTF_TIMEZONE=Asia/Kolkata
DEV_AUTH_ENABLED=false             # ONLY true for local dev/tests. Enables local email+password auth.
ALLOW_ADMIN_SUPABASE_LOGIN=false   # allow profiles.role='admin' Supabase users into /api/admin

# ---- CORS / security ----
CORS_ORIGINS=http://localhost:5173,https://ctf.wano-fest.com
ALLOWED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=              # optional; in-memory limiter is used when empty

# ---- Uploads ----
STORAGE_BACKEND=local              # local | supabase
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_MB=64
ALLOWED_UPLOAD_EXTENSIONS=.zip,.tar,.gz,.tgz,.7z,.rar,.pdf,.txt,.md,.csv,.json,.xml,.pcap,.pcapng,.cap,.png,.jpg,.jpeg,.gif,.svg,.py,.js,.ts,.java,.c,.cpp,.h,.go,.rb,.php,.sh,.sql,.elf,.bin,.so,.dll,.exe,.apk

# ---- Observability ----
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true
