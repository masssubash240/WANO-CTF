# =============================================================================
# WANO CTF — ROOT ENV TEMPLATE
# Copy to .env (local dev) and configure the real values in your host dashboards
# (Vercel for the frontend, Render/Railway for the backend, Supabase for the DB).
#
# NEVER COMMIT REAL SECRETS. Files are split by app, see:
#   frontend/.env.example  -> VITE_* variables (public, baked into the bundle)
#   backend/.env.example   -> server-only secrets
# =============================================================================

# ---- Frontend (Vercel) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_URL=http://localhost:8000
VITE_SITE_URL=https://ctf.wano-fest.com
VITE_EVENT_DATE=2026-03-14T09:00:00+05:30
VITE_EVENT_VENUE=WANO Fest Main Campus — Cyber Lab Block
VITE_WS_URL=

# ---- Backend (Render / Railway / VPS) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_LEGACY_JWT_SECRET
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(64))"
FLAG_PEPPER=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(64))"
CORS_ORIGINS=http://localhost:5173,https://ctf.wano-fest.com
CTF_TIMEZONE=Asia/Kolkata
DEV_AUTH_ENABLED=false
